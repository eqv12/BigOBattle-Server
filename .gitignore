# --- Python Cache & Compiled Files ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual Environment ---
# Never commit your virtual environment folder
venv/
.venv/
env/
.env/

# --- Project-Specific Generated Files ---
# The SQLite database should not be version controlled as it changes constantly.
# Your setup script can regenerate it.
*.db
*.db-journal

# Log files generated by the engine or bots
*.log

# Sensitive password files generated by the setup script
# WARNING: NEVER COMMIT PLAIN-TEXT PASSWORDS
organizer_passwords.json
organizer_passwords.txt

# Generated replay files
# The folder itself can exist, but its contents should be ignored.
replays/

# --- IDE / Editor Configuration ---
.vscode/
.idea/

# --- Operating System Files ---
# Windows
Thumbs.db
desktop.ini


bots_official/

TronTournamentServer/bots_official/
